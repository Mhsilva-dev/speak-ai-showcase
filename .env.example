# Speak AI — configurações. Copie: cp .env.example .env

# ----- SERVIDOR -----
NODE_ENV=production
PORT=3020
# Endereço público (links dos e-mails). Em desenvolvimento: http://localhost:3020
APP_URL=http://localhost:3020

# ----- BANCO (PostgreSQL) -----
DATABASE_URL=postgres://speak:speak@127.0.0.1:5432/speak
# Banco separado para os testes (é apagado a cada execução de npm test)
TEST_DATABASE_URL=postgres://speak:speak@127.0.0.1:5432/speak_test

# ----- SEGURANÇA -----
# String aleatória longa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo

# ----- IA (Google Gemini) -----
# Chave em https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_PROVIDER=gemini
# Minutos de conversa por voz por aluno por dia (admin: sem limite)
VOICE_DAILY_MINUTES=15
# Cotação usada no painel de custos (estimativa em reais)
USD_BRL=5.5

# ----- LOGIN COM GOOGLE (opcional) -----
# Cliente OAuth "Aplicativo da Web"; redirecionamento: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- E-MAIL (opcional: "esqueci a senha" e relatório semanal) -----
# Gmail com senha de app: https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# ----- LEMBRETE PUSH (opcional) -----
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ----- DEPLOY AUTOMÁTICO (opcional) -----
# Segredo do webhook do GitHub (push na main → scripts/deploy.sh)
DEPLOY_SECRET=
